{
  "$defs": {
    "AICoverageCandidateSuggestionV3": {
      "additionalProperties": false,
      "properties": {
        "baseline_obligation_missing": {
          "const": true,
          "title": "Baseline Obligation Missing",
          "type": "boolean"
        },
        "conversation_group_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{2,119}$",
          "title": "Conversation Group Id",
          "type": "string"
        },
        "primary_obligation": {
          "$ref": "#/$defs/DraftObligationReference"
        },
        "projected_obligations": {
          "items": {
            "$ref": "#/$defs/DraftObligationReference"
          },
          "minItems": 1,
          "title": "Projected Obligations",
          "type": "array"
        },
        "proposed_case": {
          "$ref": "#/$defs/ProposedAuthoringCase"
        },
        "relation": {
          "maxLength": 1000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Relation",
          "type": "string"
        },
        "scenario_key": {
          "enum": [
            "고객센터:a/s 접수",
            "고객센터:요금/약정 상담",
            "고객센터:인터넷/통화 문제 문의",
            "교수님:결석 사유 전달",
            "교수님:과제 문의",
            "교수님:면담 예약",
            "배달:배달 지연 문의",
            "배달:주문 변경",
            "배달:환불/재배달 문의",
            "시청:대형폐기물 배출",
            "시청:여권 발급 문의",
            "시청:주민등록 등본 문의",
            "예약:미용실 예약",
            "예약:병원 예약",
            "예약:스터디룸 예약",
            "예약:식당 예약"
          ],
          "maxLength": 1000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Scenario Key",
          "type": "string"
        },
        "semantic_valid": {
          "const": true,
          "title": "Semantic Valid",
          "type": "boolean"
        },
        "suggestion_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{2,119}$",
          "title": "Suggestion Id",
          "type": "string"
        }
      },
      "required": [
        "suggestion_id",
        "conversation_group_id",
        "scenario_key",
        "primary_obligation",
        "proposed_case",
        "relation",
        "baseline_obligation_missing",
        "semantic_valid",
        "projected_obligations"
      ],
      "title": "AICoverageCandidateSuggestionV3",
      "type": "object"
    },
    "CoverageDimension": {
      "enum": [
        "review_status",
        "scenario",
        "conversation_state",
        "user_action",
        "state_action",
        "intent",
        "field_present",
        "field_absent",
        "field_option",
        "change_field",
        "difficulty_tag",
        "action_field_present",
        "action_field_absent",
        "scenario_difficulty_tag",
        "current_fields_context",
        "current_field_present",
        "current_field_absent",
        "current_field_option",
        "current_delta_relation",
        "alternative_time_relation",
        "contrast_role"
      ],
      "title": "CoverageDimension",
      "type": "string"
    },
    "DifficultyTag": {
      "enum": [
        "single_field",
        "multi_field",
        "correction",
        "negation",
        "ellipsis",
        "colloquial",
        "ambiguous",
        "hard_negative",
        "confirmation",
        "cancellation",
        "closing",
        "safety"
      ],
      "title": "DifficultyTag",
      "type": "string"
    },
    "DraftObligationReference": {
      "additionalProperties": false,
      "description": "Point at one live-contract obligation that a proposed case is meant to exercise.",
      "properties": {
        "dimension": {
          "$ref": "#/$defs/CoverageDimension"
        },
        "scenario_key": {
          "enum": [
            "고객센터:a/s 접수",
            "고객센터:요금/약정 상담",
            "고객센터:인터넷/통화 문제 문의",
            "교수님:결석 사유 전달",
            "교수님:과제 문의",
            "교수님:면담 예약",
            "배달:배달 지연 문의",
            "배달:주문 변경",
            "배달:환불/재배달 문의",
            "시청:대형폐기물 배출",
            "시청:여권 발급 문의",
            "시청:주민등록 등본 문의",
            "예약:미용실 예약",
            "예약:병원 예약",
            "예약:스터디룸 예약",
            "예약:식당 예약"
          ],
          "maxLength": 1000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Scenario Key",
          "type": "string"
        },
        "value": {
          "maxLength": 1000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "scenario_key",
        "dimension",
        "value"
      ],
      "title": "DraftObligationReference",
      "type": "object"
    },
    "ExpectedField": {
      "additionalProperties": false,
      "properties": {
        "accepted_values": {
          "items": {
            "maxLength": 1000,
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "minItems": 1,
          "title": "Accepted Values",
          "type": "array"
        }
      },
      "required": [
        "accepted_values"
      ],
      "title": "ExpectedField",
      "type": "object"
    },
    "GoldLabels": {
      "additionalProperties": false,
      "properties": {
        "change_field": {
          "anyOf": [
            {
              "maxLength": 1000,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Change Field"
        },
        "fields": {
          "additionalProperties": {
            "anyOf": [
              {
                "$ref": "#/$defs/ExpectedField"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Fields",
          "type": "object"
        },
        "intent": {
          "anyOf": [
            {
              "maxLength": 1000,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Intent"
        },
        "user_action": {
          "maxLength": 1000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "User Action",
          "type": "string"
        }
      },
      "required": [
        "intent",
        "fields",
        "user_action",
        "change_field"
      ],
      "title": "GoldLabels",
      "type": "object"
    },
    "ProposedAuthoringCase": {
      "additionalProperties": false,
      "description": "Store an unreviewed case proposal without claiming human authorship.",
      "properties": {
        "conversation_state": {
          "maxLength": 1000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Conversation State",
          "type": "string"
        },
        "current_fields": {
          "additionalProperties": {
            "anyOf": [
              {
                "maxLength": 1000,
                "minLength": 1,
                "pattern": "\\S",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Current Fields",
          "type": "object"
        },
        "id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{2,119}$",
          "title": "Id",
          "type": "string"
        },
        "labels": {
          "$ref": "#/$defs/GoldLabels"
        },
        "offered_alternative_times": {
          "items": {
            "maxLength": 1000,
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Offered Alternative Times",
          "type": "array"
        },
        "tags": {
          "items": {
            "$ref": "#/$defs/DifficultyTag"
          },
          "minItems": 1,
          "title": "Tags",
          "type": "array"
        },
        "user_message": {
          "maxLength": 4000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "User Message",
          "type": "string"
        }
      },
      "required": [
        "id",
        "conversation_state",
        "current_fields",
        "offered_alternative_times",
        "user_message",
        "labels",
        "tags"
      ],
      "title": "ProposedAuthoringCase",
      "type": "object"
    }
  },
  "$id": "urn:maeumcall:structured-nlu:ai-coverage-candidates:v3",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Describe the exact remaining alternative-time relation delta batch.",
  "properties": {
    "automatic_promotion_allowed": {
      "const": false,
      "title": "Automatic Promotion Allowed",
      "type": "boolean"
    },
    "baseline_case_count": {
      "const": 36,
      "title": "Baseline Case Count",
      "type": "integer"
    },
    "baseline_corpus_fingerprint": {
      "const": "246e22b0d0b83b5ee0619f6ade5629c52fecb07e3b450f477efd2317da5e5ca7",
      "title": "Baseline Corpus Fingerprint",
      "type": "string"
    },
    "baseline_covered_obligation_count": {
      "const": 613,
      "title": "Baseline Covered Obligation Count",
      "type": "integer"
    },
    "baseline_diagnostic_case_ids": {
      "items": {
        "pattern": "^[a-z0-9][a-z0-9._-]{2,119}$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Baseline Diagnostic Case Ids",
      "type": "array"
    },
    "baseline_missing_obligation_count": {
      "const": 949,
      "title": "Baseline Missing Obligation Count",
      "type": "integer"
    },
    "baseline_source_root": {
      "const": "evals/structured_nlu/data/source",
      "title": "Baseline Source Root",
      "type": "string"
    },
    "baseline_split_assignment_path": {
      "const": "evals/structured_nlu/data/manifests/split-assignments.v1.json",
      "title": "Baseline Split Assignment Path",
      "type": "string"
    },
    "candidate_set_id": {
      "const": "structured-nlu-coverage-candidates-v3",
      "title": "Candidate Set Id",
      "type": "string"
    },
    "coverage_candidate_schema_version": {
      "const": 3,
      "title": "Coverage Candidate Schema Version",
      "type": "integer"
    },
    "generator_id": {
      "const": "openai-codex-coverage-candidates",
      "title": "Generator Id",
      "type": "string"
    },
    "human_review_required": {
      "const": true,
      "title": "Human Review Required",
      "type": "boolean"
    },
    "official_obligation_count": {
      "const": 1562,
      "title": "Official Obligation Count",
      "type": "integer"
    },
    "predecessor_candidate_set_id": {
      "const": "structured-nlu-coverage-candidates-v2",
      "title": "Predecessor Candidate Set Id",
      "type": "string"
    },
    "profile_fingerprint": {
      "const": "3b6fc800eca438fa0d5c49f9004f83c638930284dd26c8f365aae1be411bf580",
      "pattern": "^[0-9a-f]{64}$",
      "title": "Profile Fingerprint",
      "type": "string"
    },
    "profile_id": {
      "const": "maeumcall-structured-nlu-v3",
      "maxLength": 1000,
      "minLength": 1,
      "pattern": "\\S",
      "title": "Profile Id",
      "type": "string"
    },
    "projected_covered_obligation_count": {
      "const": 668,
      "title": "Projected Covered Obligation Count",
      "type": "integer"
    },
    "projected_marginal_gain": {
      "const": 55,
      "title": "Projected Marginal Gain",
      "type": "integer"
    },
    "projected_missing_obligation_count": {
      "const": 894,
      "title": "Projected Missing Obligation Count",
      "type": "integer"
    },
    "provenance": {
      "const": "ai_assisted_unreviewed",
      "title": "Provenance",
      "type": "string"
    },
    "suggestions": {
      "items": {
        "$ref": "#/$defs/AICoverageCandidateSuggestionV3"
      },
      "minItems": 1,
      "title": "Suggestions",
      "type": "array"
    }
  },
  "required": [
    "coverage_candidate_schema_version",
    "candidate_set_id",
    "predecessor_candidate_set_id",
    "profile_id",
    "profile_fingerprint",
    "provenance",
    "generator_id",
    "human_review_required",
    "automatic_promotion_allowed",
    "baseline_source_root",
    "baseline_split_assignment_path",
    "baseline_case_count",
    "baseline_corpus_fingerprint",
    "baseline_diagnostic_case_ids",
    "baseline_covered_obligation_count",
    "baseline_missing_obligation_count",
    "official_obligation_count",
    "projected_marginal_gain",
    "projected_covered_obligation_count",
    "projected_missing_obligation_count",
    "suggestions"
  ],
  "title": "AICoverageCandidateManifestV3",
  "type": "object"
}
