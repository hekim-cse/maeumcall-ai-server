# OpenAI structured turn generation
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Local Kanana structured analysis
# Install requirements-ml.txt before enabling.
HF_LOCAL_MODEL_ENABLED=0
HF_MODEL_NAME=kakaocorp/kanana-1.5-2.1b-instruct-2505
HF_MODEL_REVISION=7df4bc35ccd610e451809d7106e1c3cf82bfd44c
# First download: 0. After the model is cached, use 1 to prevent runtime downloads.
HF_LOCAL_FILES_ONLY=0

# Comma-separated origins. Use * only for local development.
CORS_ALLOW_ORIGINS=*
PROMPT_CACHE=1
OPENAI_TIMEOUT=8
AUDIO_UPLOAD_MAX_MB=20

# Required before storing voice baselines. Use at least 32 random characters.
# Rotating this value makes existing pseudonymous baseline keys unreachable.
# Set either the value or an absolute-path secret file, never both.
BASELINE_ID_HMAC_SECRET=
BASELINE_ID_HMAC_SECRET_FILE=

# Required PostgreSQL connection for voice baselines.
# Format: postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_CONNECT_TIMEOUT=3

# Kakao login -> Firebase authenticated session exchange.
# KAKAO_APP_ID is the numeric app_id returned by Kakao's access-token info API.
KAKAO_APP_ID=
FIREBASE_PROJECT_ID=call-phobia-app
# Independent secret used only to derive stable, pseudonymous Firebase UIDs.
# Use at least 32 random characters and keep the same value across deployments.
# Set either the value or an absolute-path secret file, never both.
AUTH_SUBJECT_HMAC_SECRET=
AUTH_SUBJECT_HMAC_SECRET_FILE=
KAKAO_TOKEN_VERIFY_TIMEOUT=5

# Firebase Admin uses Application Default Credentials.
# Point this to a service-account JSON file outside the repository when running locally.
GOOGLE_APPLICATION_CREDENTIALS=

# Required by docker-compose.yml. Use a local secret that is not committed.
POSTGRES_PASSWORD=

# Optional versioned reservation training schedule. The bundled catalog is used by default.
RESERVATION_AVAILABILITY_CATALOG_PATH=
